{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentvault-fingerprint-candidate.schema.json",
  "title": "FingerprintCandidate",
  "type": "object",
  "required": ["schema_version", "id", "stage", "rule", "assertions", "fixtures"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,63}$" },
    "stage": { "enum": ["candidate", "Candidate"] },
    "rule": {
      "type": "object",
      "properties": {
        "predicate": { "type": "string" },
        "description": { "type": "string" },
        "subject": { "type": "string" }
      },
      "anyOf": [
        { "required": ["predicate"] },
        { "required": ["description"] }
      ]
    },
    "assertions": { "type": "array" },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "expect"],
        "properties": {
          "name": { "type": "string" },
          "setup": { "type": "object" },
          "expect": { "type": "object" }
        }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "contradicts": { "type": "array", "items": { "type": "string" } }
  }
}
