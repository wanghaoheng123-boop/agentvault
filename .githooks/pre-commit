#!/usr/bin/env bash
# AgentVault: block commits that touch contested paths without a live lease.
# Enable once: git config core.hooksPath .githooks
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
CLI="$ROOT/scripts/coord/avcoord.py"
AGENT="${AVCOORD_AGENT:-orchestrator}"
RUN_ID="${AVCOORD_RUN_ID:-}"

if [[ ! -f "$CLI" || -L "$CLI" ]]; then
  echo "avcoord pre-commit: lease checker is missing or unsafe; commit denied" >&2
  exit 1
fi

fail=0
while IFS= read -r f; do
  [[ -z "$f" ]] && continue
  set +e
  args=(check-lease --agent "$AGENT" --path "$f")
  if [[ -n "$RUN_ID" ]]; then
    args+=(--run "$RUN_ID")
  fi
  out="$(python3 "$CLI" "${args[@]}" 2>&1)"
  rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    echo "avcoord pre-commit: contested path lacks live lease for $AGENT: $f" >&2
    echo "  $out" >&2
    echo "  Fix: bin/avcoord claim --agent $AGENT --resource $f" >&2
    fail=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACMRD)

exit "$fail"
