{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aeap/contracts/provenance.schema.json",
  "title": "Bitemporal dataset manifest (P1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "created_at",
    "pit_compliant",
    "source",
    "columns",
    "row_count",
    "content_sha256",
    "eligible_for_admission"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "snapshot_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "license": {
      "type": [
        "string",
        "null"
      ]
    },
    "pit_compliant": {
      "type": "boolean",
      "description": "False means the snapshot cannot satisfy P1 and is barred from admission"
    },
    "biases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Required and must be nonempty whenever pit_compliant is false"
    },
    "eligible_for_admission": {
      "type": "boolean"
    },
    "universe": {
      "type": "string"
    },
    "frequency": {
      "enum": [
        "daily",
        "weekly",
        "monthly"
      ]
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "units",
          "available_at_rule"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "feature",
              "label",
              "key",
              "regime"
            ]
          },
          "units": {
            "type": "string"
          },
          "available_at_rule": {
            "type": "string",
            "description": "How available_at is derived; must be <= decision_time"
          },
          "revision_policy": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "row_count": {
      "type": "integer",
      "minimum": 1
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "date_range": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        }
      }
    }
  }
}
