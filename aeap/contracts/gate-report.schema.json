{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aeap/contracts/gate-report.schema.json",
  "title": "Nine-gate evaluation report (B4 output)",
  "description": "Only nine PASS results, a PASS firewall/isolation receipt and a matching peer ACK can reach admission. Undefined, missing, zero-sign and insufficient-sample cases never silently pass.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "campaign_id",
    "evaluated_at",
    "code_sha256",
    "proposal_sha256",
    "data_sha256",
    "label_sha256",
    "policy_sha256",
    "reference_sha256",
    "author_run_id",
    "executor_run_id",
    "judge_run_id",
    "development_period",
    "decision_date",
    "expected_sign",
    "checks",
    "admissible",
    "blocking_reasons"
  ],
