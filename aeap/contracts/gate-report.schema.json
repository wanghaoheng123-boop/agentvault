      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reference_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "author_run_id": {
      "type": "string"
    },
    "executor_run_id": {
      "type": "string"
    },
    "judge_run_id": {
      "type": "string"
    },
