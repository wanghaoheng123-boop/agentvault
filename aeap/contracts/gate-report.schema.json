        "G1_duplicate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "enum": [
                "PASS",
                "FAIL",
                "INCONCLUSIVE",
                "NOT_RUN"
              ]
            },
            "reason": {
              "type": "string"
            },
            "estimate": {
              "type": [
                "number",
                "null"
              ]
            },
            "uncertainty": {
